/* pages/restock/restock.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}

.restock-list {
  padding: 0 20rpx;
}

.restock-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 32rpx;
  font-weight: 500;
  display: block;
}

.stock-info {
  font-size: 26rpx;
  color: #ff6b6b;
  margin-top: 10rpx;
  display: block;
}

.restock-btn {
  background-color: #4CAF50;
  color: #fff;
}

.empty-tip {
  text-align: center;
  color: #4CAF50;
  font-size: 32rpx;
  margin-top: 100rpx;
}
