/* pages/categories/categories.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

.add-btn {
  background-color: #2196F3;
  color: #fff;
}

.category-list {
  padding: 20rpx;
}

.category-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
}

.category-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.category-name {
  font-size: 32rpx;
}
