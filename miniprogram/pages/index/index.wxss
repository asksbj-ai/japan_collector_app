/* miniprogram/pages/index/index.wxss */
.container {
  padding: 30rpx;
}

.env-info {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 40rpx;
}

.env-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.env-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.env-id {
  font-size: 24rpx;
  opacity: 0.8;
  word-break: break-all;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.env-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.env-btn {
  flex: 1;
  min-width: 200rpx;
  background: #fff;
  border: 2rpx solid #667eea;
  color: #667eea;
  border-radius: 8rpx;
}

.test-btn {
  background: #667eea;
  color: #fff;
}
