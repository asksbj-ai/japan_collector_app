/* pages/search/search.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  margin: 20rpx;
  border-radius: 10rpx;
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  color: #999;
  font-size: 32rpx;
}

.search-results {
  padding: 0 20rpx;
}

.result-item {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 10rpx;
  border-radius: 10rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}
